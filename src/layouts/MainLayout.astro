---
import Navbar from "components/Navbar/index.astro";
import Footer from "components/Footer/index.astro";
import "./styles.css";

interface Props {
  backgroundImage?: string;
  description?: string;
  image?: string;
  title: string;
}

const { backgroundImage, description, image, title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta name="author" content="Adolfo Reyes" />

    <!-- Metatags -->
    <meta property="or:title" content={title} />
    <meta property="or:description" content={description} />
    <meta property="or:image" content={image} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <!-- <ClientRouter /> -->
  </head>
  <body
    style={{
      backgroundImage: `linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)),url(${backgroundImage})`,
      backgroundSize: "cover",
      backgroundPosition: "center",
      backgroundAttachment: "fixed",
      backgroundRepeat: "no-repeat",
      margin: 0,
    }}
  >
    <>
      <Navbar />
      <main>
        <slot />
      </main>
      <Footer />
      <script>
        const btnMenu = document.querySelector(".btn_menu");
        const navMenu = document.querySelector(".nav_menu");

        btnMenu?.addEventListener("click", () => {
          navMenu?.classList.toggle("active");
        });
      </script>
    </>
  </body>
</html>
