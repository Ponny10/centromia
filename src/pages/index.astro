---
import MainLayout from "layouts/MainLayout.astro";
import Button from "components/Button/index.astro";
import Text from "components/Text/index.astro";
import Icon from "components/Icon/index.astro";
import "./home.css";

const mainInformation = [
  {
    color: 'var(--color-blue)',
    description:
      "Somos un centro médico sensible y consciente de las necesidades que enfrentan nuestros pacientes, por lo que estamos comprometidos a ofrecer servicios de calidad con un sentido humano y altruista, promoviendo la importancia de la nutrición desde un enfoque científico ayudando a tener una vida sana y placentera.",
    id: 0,
    img: "centromia_nosotros.jpg",
    title: "¿Quiénes somos?",
  },
  {
    color: 'var(--color-purple)',
    description:
      "Contamos con diferentes alternativas para ayudarte a mejorar tu estado de salud actual, tu estado nutricio y emocional.",
    id: 1,
    img: "centromia_servicios.jpg",
    title: "Nuestros servicios",
  },
  {
    color: 'var(--color-green)',
    description:
      "Contamos con una gran variedad de productos para el bienestar de tu cuerpo, entre ellos se encuentran los aceites y extractos, los cuáles cuentan con muchos beneficios.",
    id: 2,
    img: "centromia_productos.jpg",
    title: "Nuestro productos",
  },
];
---

<MainLayout backgroundImage="centromia_inicio.gif" title="Inicio">
  <div
    style={{
      display: "flex",
      flexDirection: "column",
      alignItems: "center",
      justifyContent: "center",
      height: "calc(100vh - 90px)",
    }}
  >
    <Text
      color="#e0e0e0"
      fontSize={44}
      fontWeight="700"
      text="Bienvenido al Centro Médico Integral Anáhuac"
      textAlign="center"
      type={"h1"}
      styles={{
        textShadow: "2px 2px 2px var(--color-green)",
      }}
    />
    <Button
      padding={12}
      marginTop={12}
      borderRadius={6}
      styles={{ borderStyle: "none" }}
    >
      <Text
        textAlign="center"
        fontSize={24}
        fontWeight="700"
        styles={{ color: "var(--color-blue)" }}
      >
        Agendar cita
      </Text>
    </Button>
    <Button
      padding={12}
      marginTop={12}
      borderRadius={6}
      styles={{
        borderStyle: "none",
        backgroundColor: "var(--background-white)",
      }}
    >
      <Text
        textAlign="center"
        fontSize={24}
        fontWeight="700"
        styles={{ color: "var(--color-blue)" }}
      >
        Contactar
      </Text>
    </Button>
  </div>
  <div class="home_main_information_content">
    {
      mainInformation.map(({ description, id, img, title, color }, index: number) => (
        <div
          class="home_main_information"
          style={
            {
              /* flexDirection: index % 2 === 0 ? 'row' : 'row-reverse' */
            }
          }
        >
          <Icon
            alt={title}
            border={6}
            src={img}
            style={{ width: "100%", height: "100%" }}
          />
          <Text
            fontSize={24}
            color={color}
            fontWeight="700"
            marginTop={12}
          >
            {title}
          </Text>
          <Text
            fontSize={12}
            color="var(--color-dark)"
            fontWeight="300"
          >
            {description}
          </Text>
        </div>
      ))
    }
  </div>
</MainLayout>
