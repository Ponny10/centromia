---
import Icon from "components/Icon/index.astro";
import "./styles.css";

const navbarOptions = [
  {
    href: "/",
    id: 0,
    page: "Inicio",
  },
  {
    href: "/servicios",
    id: 1,
    page: "Servicios",
  },
  {
    href: "/productos",
    id: 2,
    page: "Productos",
  },
  {
    href: "/nosotros",
    id: 3,
    page: "Nosotros",
  },
  {
    href: "/equipo",
    id: 4,
    page: "Equipo",
  },
  {
    href: "/contacto",
    id: 5,
    page: "Contacto",
  },
];

const { pathname } = Astro.url;
---

<nav>
  <Icon
    alt="Centro MIA logotipo"
    border={6}
    height={70}
    src="centromia_logo.svg"
    width={150}
  />
  <div class="nav_menu">
    {
      navbarOptions.map(({ href, page }) => (
        <a href={href} class="nav_option `${pathname === href && 'nav_option_active'}`">{page}</a>
      ))
    }
  </div>
  <Icon
    class="btn_menu"
    alt="Menu opciones de navegación"
    size={36}
    src="menu.svg"
  />
</nav>
